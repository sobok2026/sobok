{
  "$schema": "https://turborepo.dev/schema.json",
  // Every workspace tsconfig extends tsconfig.base.json, but turbo hashes only a task's own package inputs —
  // without this, editing a compiler option there invalidates `//#type:root` and NOTHING else, so all 24
  // package `type` tasks replay a cached PASS across a change that affects every one of them.
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV"],
      "outputs": [".next/**", "dist/**"]
    },
    "@sobok/web#build": {
      "dependsOn": ["^build"],
      "env": [
        "ANALYZE",
        "BUILD_OUTPUT",
        "CI",
        "COMMIT_SHA",
        "NEXT_PUBLIC_APP_ENV",
        "NEXT_PUBLIC_APP_ORIGIN",
        "NEXT_PUBLIC_COMMIT_SHA",
        "NEXT_PUBLIC_FARO_URL",
        "NEXT_PUBLIC_GTM_ID",
        "NEXT_PUBLIC_IMAGE_PROXY_ORIGIN",
        "NEXT_PUBLIC_IOS_TESTFLIGHT_URL",
        "NEXT_PUBLIC_PROXY_MANGA_ORIGIN",
        "NEXT_PUBLIC_PROXY_SEARCH_ORIGIN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY"
      ],
      "passThroughEnv": ["APP_POSTGRES_CERTIFICATE", "APP_POSTGRES_URL", "SENTRY_AUTH_TOKEN"],
      "inputs": ["$TURBO_DEFAULT$", ".env.prod.build"],
      "outputs": [".next/**"]
    },
    // The sitekey is inlined into the bundle by Next, so it belongs in the cache key: without it, changing
    // the widget replays a cached bundle still carrying the old sitekey — the exact silent staleness the
    // `requireEnv` in src/constants.ts exists to catch. `.env.local` is gitignored, so $TURBO_DEFAULT$ does
    // not cover it either.
    "@sobok/stella#build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_TURNSTILE_SITE_KEY"],
      "outputs": ["out/**", ".next/**"]
    },
    "@sobok/civil#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", ".next/**"]
    },
    "@sobok/accounts#build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_GOOGLE_CLIENT_ID", "NEXT_PUBLIC_TURNSTILE_SITE_KEY"],
      "outputs": ["out/**", ".next/**"]
    },
    "@sobok/vibe#build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_DEEPTYPE_PAY_PROFILE", "NEXT_PUBLIC_TURNSTILE_SITE_KEY"],
      "outputs": ["out/**", ".next/**"]
    },
    "@sobok/zwds#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", ".next/**"]
    },
    "@sobok/horn#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", ".next/**"]
    },
    "@sobok/emberhold#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", ".next/**"]
    },
    "@sobok/fall#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", ".next/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:prod": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "start:local": {
      "cache": false
    },
    "start:prod": {
      "cache": false
    },
    "@sobok/api#start:local": {
      "cache": false,
      "persistent": true
    },
    "@sobok/api#start:prod": {
      "cache": false,
      "persistent": true
    },
    "@sobok/web#start:local": {
      "cache": false,
      "persistent": true
    },
    "@sobok/web#start:prod": {
      "cache": false,
      "persistent": true
    },
    // `^type` is what makes a consumer re-check when a dependency's SOURCE changes: a task's hash folds in
    // its dependencies' hashes, and without the edge the dependency graph is invisible to caching (change a
    // shared helper's signature and @sobok/stella#type replays a cached pass without re-checking any call site).
    "type": {
      "dependsOn": ["^type"],
      "outputs": []
    },
    // A package-task config REPLACES the base entry rather than merging, so `^type` has to be repeated here.
    "@sobok/web#type": {
      "dependsOn": ["^build", "^type"],
      "outputs": []
    },
    "//#type:root": {
      "outputs": []
    }
  }
}

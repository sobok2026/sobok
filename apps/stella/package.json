{
  "name": "@sobok/stella",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "preview": "STELLA_DB_SCHEMA=stella_stg next build && wrangler dev --env stg",
    "deploy": "STELLA_DB_SCHEMA=stella next build && wrangler deploy --env=\"\"",
    "db:push": "drizzle-kit push",
    "questionnaire:validate": "bun run scripts/publish-guardian-questionnaire.ts --validate-only",
    "questionnaire:publish": "bun run scripts/publish-guardian-questionnaire.ts",
    "type": "next typegen && tsc --noEmit && tsc -p worker/tsconfig.json && tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.3",
    "@sobok/analytics": "workspace:*",
    "@sobok/brand": "workspace:*",
    "@sobok/domain": "workspace:*",
    "@sobok/edge": "workspace:*",
    "@sobok/payments": "workspace:*",
    "@sobok/site-chrome": "workspace:*",
    "@sobok/site-i18n": "workspace:*",
    "@sobok/site-seo": "workspace:*",
    "@sobok/typography": "workspace:*",
    "@swisseph/browser": "1.1.0",
    "@tanstack/react-query": "^5.101.1",
    "downshift": "^9.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.12.27",
    "moment-timezone": "0.5.48",
    "next": "16.2.11",
    "next-intl": "^4.13.0",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.0",
    "@sobok/next-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  }
}

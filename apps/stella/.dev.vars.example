# Local `wrangler dev` config. Copy to .dev.vars (gitignored). Prod is provisioned declaratively in
# sobok-ops (Terraform) — nothing here is used in production.

# Non-secret vars — these OVERRIDE the wrangler.jsonc `vars` of the same name for `wrangler dev`. (Wrangler
# merges the two and lets .dev.vars win; Cloudflare never spells this out in prose, so don't go hunting for
# the doc sentence.) NOTE these do not compose with .env*: once a .dev.vars file exists, wrangler stops
# loading .env/.env.local into the Worker entirely. Put Worker vars HERE, not in .env.local — otherwise the
# host pin silently stays at the production value and every local solve is rejected.
#
# The Turnstile host pin must name the host you actually serve locally, because siteverify echoes back the
# hostname the widget was solved on and the Worker rejects anything not in this list.
STELLA_ALLOWED_HOSTNAMES="localhost"
# Canonical origin and transactional email identity used by the Worker. Never derive recovery URLs from the
# incoming Host header. A local mail sandbox may replace the sender, but production uses the verified
# stella.sobok.cc domain declared in wrangler.jsonc.
STELLA_PUBLIC_ORIGIN="http://localhost:3010"
STELLA_ACCOUNTS_ISSUER="http://localhost:3014"
STELLA_OIDC_CLIENT_ID="stella-local"
STELLA_EMAIL_FROM="Stella <reports@stella.sobok.cc>"
STELLA_EMAIL_REPLY_TO="sobok2026@gmail.com"

# The 4 top-level bindings are Cloudflare Secrets Store secrets (accessed via `await env.X.get()`). For local
# dev, seed a LOCAL secrets store (no --remote) so they resolve offline — one per binding's secret_name:
#   wrangler secrets-store secret create <STORE_ID> --name stella-turnstile-secret         --value "…" --scopes workers
#   wrangler secrets-store secret create <STORE_ID> --name stella-ip-hash-salt             --value "…" --scopes workers
#   wrangler secrets-store secret create <STORE_ID> --name stella-discord-webhook          --value ""  --scopes workers
#   wrangler secrets-store secret create <STORE_ID> --name stella-resend-api-key-production --value "…" --scopes workers
#   wrangler secrets-store secret create <STORE_ID> --name stella-resend-api-key-staging    --value "…" --scopes workers
#   wrangler secrets-store secret create <STORE_ID> --name stella-auth-secret-staging       --value "…" --scopes workers
#   wrangler secrets-store secret create <STORE_ID> --name stella-oidc-client-secret-staging --value "…" --scopes workers
# (empty discord value = alerts disabled.)
# Register `stella-local` once in identity_stg with the exact local callback
# http://localhost:3010/api/auth/oauth2/callback/sobok. Its confidential secret must be the same value as
# the local `stella-oidc-client-secret-staging` binding; it never belongs in this file.
# PortOne credentials now exist only in apps/payments. Run that Worker alongside Stella so the PAYMENTS
# Service Binding resolves; no PortOne secret or channel key is copied into this app.
#
# The Turnstile value must be the DEV widget's real secret (`terraform output -raw dev_turnstile_secret_key`
# in sobok-ops), NOT Cloudflare's 1x00…AA test key. The test key makes siteverify answer from the secret alone
# with hostname "example.com", which can never satisfy the hostname pin in @sobok/edge/turnstile — by design,
# so that no bypass branch exists to ship to production. Pair it with the dev widget's sitekey in
# NEXT_PUBLIC_TURNSTILE_SITE_KEY (see .env.local.example); the dev widget covers localhost.

# Local Hyperdrive → point the single binding at a local/dev Postgres for `wrangler dev` (current docs use
# the CLOUDFLARE_ prefix; the WRANGLER_ form is an older fallback):
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgres://…"

# drizzle-kit push and paid-questionnaire publication target — schema migrator connection (bypasses
# Hyperdrive), Supabase session pooler. The package scripts load the tracked Supabase root CA and the URL
# must verify both the CA and pooler hostname. Production runtime talks to Postgres via Hyperdrive:
# SOBOK_POSTGRES_URL_DIRECT="postgres://stella_stg_migrator.<project-ref>:…@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=verify-full"
#
# Schema push has no default. Use the migrator URL that owns the selected namespace:
#   SOBOK_DB_SCHEMA=stella_stg bun run db:push
#   SOBOK_DB_SCHEMA=stella     bun run db:push
# Questionnaire publication uses the same explicit schema boundary:
#   SOBOK_DB_SCHEMA=stella_stg bun run questionnaire:publish --file content/guardian-questionnaires/<version>.json
#   SOBOK_DB_SCHEMA=stella     bun run questionnaire:publish --file content/guardian-questionnaires/<version>.json \
#     --expected-hash <staging-sha256>

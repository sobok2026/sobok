{
  "provider": "cloudflare_r2",
  "infrastructureOwner": "sobok-ops/infra/cloudflare/account/sobok/stella",
  "objectDeploymentOwner": "sobok/.github/workflows/guardian-card-art-deploy.yml",
  "runtimeOriginBinding": "STELLA_GUARDIAN_ASSET_ORIGIN",
  "locale": "ko",
  "plannedAssetCount": 1056,
  "legacyObjectKeyTemplate": "guardian-cards/ko/{editionId}.webp",
  "objectKeyTemplate": "guardian-cards/ko/{editionId}.{deliverySha256_12}.webp",
  "artworkPathTemplate": "{origin}/{objectKey}",
  "editionIdPolicy": "Edition IDs stay stable for artwork corrections. Meaningful card-content changes create a new edition ID; corrected or new artwork uses a content-addressed object key and never overwrites published bytes.",
  "sourceContract": {
    "format": "png",
    "width": 1080,
    "height": 1440,
    "trackedInGit": false
  },
  "deliveryContract": {
    "format": "webp",
    "mimeType": "image/webp",
    "width": 1080,
    "height": 1440,
    "quality": 82,
    "effort": 6,
    "smartSubsample": true,
    "cacheControl": "public, max-age=31536000, immutable",
    "trackedInGit": false
  },
  "environments": {
    "staging": {
      "bucket": "stella-guardian-assets-stg",
      "origin": "https://guardian-assets-stg.sobok.cc"
    },
    "production": {
      "bucket": "stella-guardian-assets",
      "origin": "https://guardian-assets.sobok.cc"
    }
  }
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella",
  "compatibility_date": "2026-07-01",
  // Assets-only Worker (no `main`): the static export in ./out is served directly at the edge via Workers Static Assets.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}

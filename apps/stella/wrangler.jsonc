{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stella",
  // A Worker WITH static assets: `main` handles /api/* (comments and paid-card authority — Supabase/Hyperdrive
  // DB and secrets must stay server-side); everything else is the static Next export in ./out.
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  // Required by postgres.js (Supabase Postgres over the Workers TCP socket API via Hyperdrive).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // The hostnames a Turnstile solve is accepted from, comma-separated. This is a security pin, so the
  // PRODUCTION value lives here — version-controlled and reviewed exactly like the literal it replaced. It is
  // a var rather than a constant only so `.dev.vars` can narrow it to `localhost` on a laptop, where the
  // separate dev widget is the one being solved. An empty value is treated as a misconfiguration, never as a
  // reason to reject every visitor (see worker/lib/turnstile.ts).
  //
  // Cloudflare auto-covers subdomains of a widget's configured domain, so the widget itself cannot narrow
  // this — the list below is the actual pin. stella serves BOTH the apex and stella.sobok.cc today.
  // CUTOVER: drop 'sobok.cc' when apps/web takes the apex from this Worker.
  "vars": {
    "STELLA_ALLOWED_HOSTNAMES": "sobok.cc,stella.sobok.cc"
  },
  "services": [{ "binding": "PAYMENTS", "service": "payments", "entrypoint": "StellaPayments" }],
  "queues": {
    "consumers": [
      {
        "queue": "stella-payment-events",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60,
        "dead_letter_queue": "stella-payment-events-dlq"
      }
    ]
  },
  "hyperdrive": [
    {
      // Single origin over the SHARED Supabase Postgres, authenticating as the least-privilege `stella_app`
      // role. Caching DISABLED — comments, entitlements, ownership, and guarantee progress require fresh
      // read-after-write state.
      "binding": "HYPERDRIVE",
      "id": "fba6a34ba67a4d0588d71266b13d57b9"
    }
  ],
  // One cron (worker `scheduled` handler): daily 03:00 → retention purge (also keeps the shared Supabase
  // project warm past the free-tier 7-day inactivity pause).
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "define": {
    "STELLA_DB_SCHEMA": "'stella'"
  },
  "secrets_store_secrets": [
    {
      "binding": "STELLA_TURNSTILE_SECRET",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "stella-turnstile-secret"
    },
    {
      "binding": "STELLA_IP_HASH_SALT",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "stella-ip-hash-salt"
    },
    {
      "binding": "STELLA_DISCORD_WEBHOOK",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "stella-discord-webhook"
    }
  ],
  // `vars`, `define`, Hyperdrive, and Secrets Store bindings are non-inheritable. Repeat the complete set in
  // the named environment so `wrangler deploy --env stg` creates a separate `stella-stg` Worker while reusing
  // the same database connection pool and credentials. Only the qualified PostgreSQL schema and hostname pin
  // differ.
  "env": {
    "stg": {
      "workers_dev": false,
      "define": {
        "STELLA_DB_SCHEMA": "'stella_stg'"
      },
      "vars": {
        "STELLA_ALLOWED_HOSTNAMES": "stella-stg.sobok.cc"
      },
      "services": [{ "binding": "PAYMENTS", "service": "payments-stg", "entrypoint": "StellaPayments" }],
      "queues": {
        "consumers": [
          {
            "queue": "stella-payment-events-stg",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "retry_delay": 60,
            "dead_letter_queue": "stella-payment-events-stg-dlq"
          }
        ]
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "fba6a34ba67a4d0588d71266b13d57b9"
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "STELLA_TURNSTILE_SECRET",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "stella-turnstile-secret"
        },
        {
          "binding": "STELLA_IP_HASH_SALT",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "stella-ip-hash-salt"
        },
        {
          "binding": "STELLA_DISCORD_WEBHOOK",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "stella-discord-webhook"
        }
      ]
    }
  }
}

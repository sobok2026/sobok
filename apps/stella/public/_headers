# Workers Static Assets custom headers (copied into ./out by `next build`).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  # Default for HTML pages and other unhashed assets: always revalidate so a
  # deploy propagates immediately. The immutable rules below are both later and
  # more specific, so hashed assets keep their long-lived cache.
  Cache-Control: public, max-age=0, must-revalidate

# Next.js content-hashes everything under /_next/static, so browsers may cache it forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Vendored font URLs include their upstream version, so they are immutable too.
/fonts/pretendard-jp/1.3.9/*
  Cache-Control: public, max-age=31536000, immutable

# Ephemeris URLs contain each file's full SHA-256 digest.
/ephemeris/*
  Cache-Control: public, max-age=31536000, immutable

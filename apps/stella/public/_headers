# Workers Static Assets custom headers (copied into ./out by `next build`).
#
# Cloudflare joins a header that two matching rules both set with a comma, so `/*` must not set Cache-Control:
# the hashed paths would end up with both max-age values. Everything not listed below keeps the platform
# default, `public, max-age=0, must-revalidate`, which is what HTML needs for a deploy to show at once.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Next.js content-hashes everything under /_next/static, so browsers may cache it forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Vendored font URLs include their upstream version, so they are immutable too.
/fonts/pretendard/1.3.9/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/pretendard-jp/1.3.9/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/noto-sans-sc/5.3.0/*
  Cache-Control: public, max-age=31536000, immutable

# Ephemeris URLs contain each file's full SHA-256 digest.
/ephemeris/*
  Cache-Control: public, max-age=31536000, immutable

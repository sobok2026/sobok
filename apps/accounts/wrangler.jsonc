{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "accounts",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "services": [{ "binding": "DATABASE", "service": "database", "entrypoint": "AccountsService" }],
  "env": {
    "stg": {
      "workers_dev": false,
      "services": [{ "binding": "DATABASE", "service": "database-stg", "entrypoint": "AccountsService" }]
    }
  }
}

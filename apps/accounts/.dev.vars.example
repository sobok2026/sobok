# Local accounts Worker configuration. Copy to `.dev.vars` (gitignored); production and staging bindings are
# declared in wrangler.jsonc after the accounts Hyperdrive has been provisioned by sobok-ops.
ACCOUNTS_PUBLIC_ORIGIN="http://localhost:3014"
ACCOUNTS_ALLOWED_HOSTNAMES="localhost"
ACCOUNTS_FIRST_PARTY_CLIENT_IDS="stella-local"
ACCOUNTS_EMAIL_FROM="Sobok Accounts <accounts@example.invalid>"
ACCOUNTS_EMAIL_REPLY_TO="sobok2026@gmail.com"
ACCOUNTS_GOOGLE_CLIENT_ID="<accounts-dev-google-client-id>"
ACCOUNTS_KAKAO_CLIENT_ID="<accounts-dev-kakao-client-id>"
ACCOUNTS_BBATON_CLIENT_ID="<accounts-dev-bbaton-client-id>"

# HYPERDRIVE local override (binding name suffix is HYPERDRIVE):
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgres://…"
#
# Authority, Turnstile, upstream OAuth, and Resend credentials are Secrets Store bindings. Seed a local
# Secrets Store with the names declared in wrangler.jsonc; do not put their values in this file.

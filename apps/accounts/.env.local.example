# Public values inlined into the static accounts UI at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<accounts-dev-turnstile-sitekey>
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<accounts-dev-google-client-id>

# Build-time PostgreSQL schema qualifier. Local development uses the staging namespace.
ACCOUNTS_DB_SCHEMA=identity_stg

# Direct owner connection used only by drizzle-kit and OAuth client bootstrap commands. The package scripts
# load the tracked Supabase root CA; the URL must request CA and hostname verification. The Worker runtime
# uses Hyperdrive instead. Keep the actual URL in `.env.local`, which is gitignored.
# ACCOUNTS_POSTGRES_URL_DIRECT="postgres://…?sslmode=verify-full"

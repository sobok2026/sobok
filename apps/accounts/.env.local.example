# Public values inlined into the static accounts UI at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<accounts-dev-turnstile-sitekey>
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<accounts-dev-google-client-id>

# Staging-project migrator connection used only by drizzle-kit and OAuth client bootstrap commands. Package scripts
# load the tracked Supabase root CA; the URL must request CA and hostname verification. The Database Worker
# runtime uses Hyperdrive instead. Keep the actual URL in `.env.local`, which is gitignored.
# SOBOK_MIGRATOR_URL="postgres://accounts_migrator.<staging-project-ref>:…@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=verify-full"

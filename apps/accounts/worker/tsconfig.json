{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "typeRoots": ["../../../node_modules", "../../../node_modules/@types"],
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "~/*": ["./*"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}

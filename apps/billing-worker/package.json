{
  "name": "@sobok/billing-worker",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --minify --sourcemap src/index.ts --target=bun --outfile dist/billing-worker",
    "start": "bun run start:local",
    "start:local": "bun --env-file=.env.local src/index.ts",
    "start:prod": "bun --env-file=.env.prod.runtime src/index.ts",
    "type": "tsc --noEmit",
    "docker:build": "docker build -f Dockerfile -t sobok-billing-worker-local ../..",
    "docker:run": "docker run --rm --env-file .env.prod.runtime sobok-billing-worker-local"
  },
  "dependencies": {
    "@sobok/payments": "workspace:*",
    "@sobok/db": "workspace:*",
    "@sobok/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}

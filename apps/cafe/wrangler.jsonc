{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cafe",
  "compatibility_date": "2026-09-24",
  // Terraform in sobok-ops owns cafe.sobok.cc; Wrangler owns the Vite static assets.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // No `not_found_handling`: the game has a single URL, so a missing file is a real 404 rather than index.html.
  "assets": {
    "directory": "./dist"
  }
}

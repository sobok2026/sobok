        {
          "id": "step-4",
          "label": "완성 및 제공",
          "instructions": ["프리 푸어로 테두리 아래 6mm까지 채워 음료가 스팀 우유 반, 거품 반이 되도록 한다."],
          "notes": [],
          "operations": [
            {
              "action": "transfer",
              "from": "steam-pitcher",
              "into": "serving-cup",
              "amount": {
                "kind": "fraction",
                "numerator": 1,
                "denominator": 2,
                "of": "테두리 아래 6mm까지 완성된 음료"
              },
              "portion": "liquid"
            },
            {
              "action": "transfer",
              "from": "steam-pitcher",
              "into": "serving-cup",
              "amount": {
                "kind": "rim-gap",

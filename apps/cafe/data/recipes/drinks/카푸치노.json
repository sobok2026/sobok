                    "value": 2,
                    "unit": "shot"
                  }
                }
              },
              "method": "regular"
            }
          ]
        },
        {
          "id": "step-3",
          "label": "향 시럽 추가",
          "instructions": ["고객이 향 시럽 추가를 요청한 경우에만 펌프를 끝까지 눌러 넣는다."],
          "notes": [],
          "operations": [
            {
              "action": "add",
              "materialId": "고객이-선택한-향-시럽",

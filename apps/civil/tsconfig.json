{
  "extends": "@sobok/next-config/tsconfig.static-site.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "*.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "worker-configuration.generated.d.ts",
    "compute-configuration.generated.d.ts",
    "worker",
    "compute"
  ]
}

FROM oven/bun:1.3.13-slim AS bun-runtime

FROM clamav/clamav:1.4.6-debian13-slim

ENV NODE_ENV=production \
    PORT=8080

COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun

USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends file \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --chown=clamav:clamav compute/artifact ./compute/artifact
COPY --chown=clamav:clamav src/domain/artifact.ts ./src/domain/artifact.ts

USER clamav

EXPOSE 8080

ENTRYPOINT []
CMD ["bun", "run", "compute/artifact/server.ts"]

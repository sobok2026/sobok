{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "typeRoots": ["../../node_modules", "../../node_modules/@types"],
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@civil-worker/*": ["../civil/worker/*"],
      "@deep-type/*": ["../vibe/deep-type/*"],
      "@stella-worker/*": ["../stella/worker/*"],
      "@vibe-worker/*": ["../vibe/worker/*"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["worker/**/*.ts", "worker-configuration.generated.d.ts"]
}

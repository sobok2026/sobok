{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "database",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "8b899fb06f9448518a1e679618552da8"
    },
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "5257f1944a2a49848a7996997f56f8e6"
    }
  ],
  "services": [
    { "binding": "STELLA_PAYMENTS", "service": "payments", "entrypoint": "StellaPayments" },
    { "binding": "VIBE_PAYMENTS", "service": "payments", "entrypoint": "VibePayments" }
  ],
  "queues": {
    "producers": [{ "binding": "ACCOUNTS_EMAIL_QUEUE", "queue": "accounts-email" }],
    "consumers": [
      {
        "queue": "accounts-email",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60,
        "dead_letter_queue": "accounts-email-dlq"
      },
      {
        "queue": "stella-payment-events",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60,
        "dead_letter_queue": "stella-payment-events-dlq"
      },
      {
        "queue": "vibe-payment-events",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60,
        "dead_letter_queue": "vibe-payment-events-dlq"
      }
    ]
  },
  "vars": {
    "ACCOUNTS_PUBLIC_ORIGIN": "https://accounts.sobok.cc",
    "ACCOUNTS_ALLOWED_HOSTNAMES": "accounts.sobok.cc",
    "ACCOUNTS_FIRST_PARTY_CLIENT_IDS": "stella-web",
    "ACCOUNTS_EMAIL_FROM": "Sobok Accounts <accounts@accounts.sobok.cc>",
    "ACCOUNTS_EMAIL_REPLY_TO": "sobok2026@gmail.com",
    "ACCOUNTS_GOOGLE_CLIENT_ID": "",
    "ACCOUNTS_KAKAO_CLIENT_ID": "",
    "ACCOUNTS_BBATON_CLIENT_ID": "",
    "STELLA_ALLOWED_HOSTNAMES": "sobok.cc,stella.sobok.cc",
    "STELLA_PUBLIC_ORIGIN": "https://stella.sobok.cc",
    "STELLA_ACCOUNTS_ISSUER": "https://accounts.sobok.cc",
    "STELLA_OIDC_CLIENT_ID": "stella-web",
    "STELLA_EMAIL_FROM": "Stella <reports@stella.sobok.cc>",
    "STELLA_EMAIL_REPLY_TO": "sobok2026@gmail.com",
    "DEEPTYPE_PAY_PROFILE": "production",
    "DEEPTYPE_PUBLIC_ORIGIN": "https://vibe.sobok.cc",
    "DEEPTYPE_EMAIL_FROM": "sobok <sobok2026@gmail.com>",
    "DEEPTYPE_EMAIL_REPLY_TO": "sobok2026@gmail.com",
    "DEEPTYPE_REPORT_MODEL": "",
    "DEEPTYPE_GA4_MEASUREMENT_ID": "G-RHHX4JRYDS"
  },
  "secrets_store_secrets": [
    {
      "binding": "ACCOUNTS_AUTH_SECRET",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "accounts-auth-secret-production"
    },
    {
      "binding": "ACCOUNTS_IP_HASH_SALT",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "accounts-ip-hash-salt-production"
    },
    {
      "binding": "ACCOUNTS_TURNSTILE_SECRET",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "accounts-turnstile-secret"
    },
    {
      "binding": "ACCOUNTS_GOOGLE_CLIENT_SECRET",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "accounts-google-client-secret-production"
    },
    {
      "binding": "ACCOUNTS_KAKAO_CLIENT_SECRET",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "accounts-kakao-client-secret-production"

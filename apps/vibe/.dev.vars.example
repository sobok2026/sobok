# Local Worker secrets for `wrangler dev` (copy to .dev.vars, which is gitignored).
# In production these are set with `wrangler secret put <NAME>` — never committed.
DEEPTYPE_PORTONE_STORE_ID=""
DEEPTYPE_PORTONE_CHANNEL_KEY=""
DEEPTYPE_PORTONE_API_SECRET=""
DEEPTYPE_PORTONE_WEBHOOK_SECRET=""
DEEPTYPE_ANTHROPIC_API_KEY=""
DEEPTYPE_LLM_ENABLED="1"
DEEPTYPE_TURNSTILE_SECRET=""

# Local Hyperdrive → point both bindings at a local/dev Postgres for `wrangler dev`
# (wrangler reads these to stand in for the Hyperdrive configs locally):
# WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_FRESH="postgres://…"
# WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_CACHED="postgres://…"

# drizzle-kit push target (OWNER role, direct connection, sslmode=require):
# DEEPTYPE_POSTGRES_URL_DIRECT="postgres://owner:…@…aivencloud.com:.../defaultdb?sslmode=require"

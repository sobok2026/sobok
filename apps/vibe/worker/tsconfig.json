{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    // Override the base's @types-only typeRoots so the scoped Workers runtime types resolve.
    "typeRoots": ["../../../node_modules", "../../../node_modules/@types"],
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@deep-type/*": ["../deep-type/*"],
      "~/*": ["./*"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // The worker never loads a test file, and `bun:test` types are absent from `types` above on purpose.
  "include": ["**/*.ts", "../deep-type/**/*.ts"],
  "exclude": ["**/*.test.ts", "../deep-type/**/*.test.ts"]
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vibe",
  // A Worker WITH static assets: `main` handles /api/* (the deeptype paid backend — PortOne secrets and
  // the Supabase/Hyperdrive DB must stay server-side); everything else is the static Next export in ./out,
  // served directly at the edge.
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  // Required by postgres.js (Supabase Postgres over the Workers TCP socket API via Hyperdrive).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // API routes always hit the Worker first so they can never be shadowed by an asset.
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      // FRESH = money/entitlement path (never stale);
      "binding": "HYPERDRIVE_FRESH",
      "id": "14e658152a554541b0e1a6712fc43787"
    },
    {
      // CACHED = done-report reads only.
      "binding": "HYPERDRIVE_CACHED",
      "id": "a2a2c4cb90d94e6fb08b0eb6727bb61d"
    }
  ],
  // Crons (worker `scheduled` handler): every 15 min → reconcile stuck 'pending'; daily 03:00 → retention purge.
  "triggers": { "crons": ["*/15 * * * *", "0 3 * * *"] },
  // Build-time substitution (esbuild `define`), NOT a binding: `pgSchema()` runs at module load, before any
  // binding exists. The value is a JS expression source, so the inner quotes are load-bearing — dropping them
  // substitutes a bare identifier and the Worker throws on boot. See worker/db/schema-name.ts.
  "define": { "DEEPTYPE_DB_SCHEMA": "'deeptype'" },
  "vars": {
    "DEEPTYPE_PORTONE_STORE_ID": "store-b5e2140b-9036-4122-b95a-caa90fc1e926",
    // 실연동. Pinned per wrangler environment for the same reason the channel keys are, and paired with the
    // build's NEXT_PUBLIC_DEEPTYPE_PAY_TIER by one expression in .github/workflows/vibe-deploy.yml.
    "DEEPTYPE_PAY_TIER": "live",
    // Every channel this deployment can spend, keyed by PortOne pgProvider. A new channel is one line here
    // and one in env.stg — no binding, no resolver. deep-type/pay-method.ts owns which method rides which.
    //
    // A channel appears here ONLY once its 원천사 심사 is complete, and it is added in the same commit that adds
    // it to `SELLABLE_CHANNELS.live`. Never a placeholder and never "": a key that exists but cannot charge
    // opens a window that never approves, and a placeholder is truthy so nothing downstream can catch it. The
    // key set here must equal `sellableChannels('live')` — `GET /api/deep-type/config` reports the difference.
    "DEEPTYPE_PORTONE_CHANNELS": {
      "tosspay_v2": "channel-key-d14e0af9-18be-457f-aa21-228e7265211f"
    },
    "DEEPTYPE_PUBLIC_ORIGIN": "https://vibe.sobok.cc",
    "DEEPTYPE_EMAIL_FROM": "sobok <sobok2026@gmail.com>",
    "DEEPTYPE_EMAIL_REPLY_TO": "sobok2026@gmail.com",
    "DEEPTYPE_REPORT_MODEL": "claude-haiku-4-5-20251001",
    // Narration killswitch only. "0" ships the rule-engine report alone; the paid report never depends on it.
    "DEEPTYPE_LLM_ENABLED": "1",
    "DEEPTYPE_GA4_MEASUREMENT_ID": "G-RHHX4JRYDS"
  },
  "secrets_store_secrets": [
    {
      "binding": "DEEPTYPE_PORTONE_API_SECRET",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "deeptype-portone-api-secret"
    },
    {
      "binding": "DEEPTYPE_PORTONE_WEBHOOK_SECRET",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "deeptype-portone-webhook-secret"
    },
    {
      "binding": "DEEPTYPE_ANTHROPIC_API_KEY",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "deeptype-anthropic-api-key"
    },
    {
      "binding": "DEEPTYPE_RESEND_API_KEY",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "deeptype-resend-api-key"
    },
    {
      "binding": "DEEPTYPE_TURNSTILE_SECRET",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "vibe-turnstile-secret"
    },
    {
      "binding": "DEEPTYPE_DISCORD_WEBHOOK",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "deeptype-discord-webhook"
    },
    {
      "binding": "DEEPTYPE_GA4_API_SECRET",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "deeptype-ga4-api-secret"
    }
  ],
  // ── Test money, deployed apart ──────────────────────────────────────────────────────────────────────
  // The PortOne test channel is separated by DEPLOYMENT and never by a runtime flag. /checkout is the single
  // place a channel key is chosen, so a production build that could ever be talked into serving the test key
  // is a production build that hands out paid reports for nothing. `DEEPTYPE_PAY_TIER` rides the same rule: it
  // says which contract set this deployment holds, and nothing infers it from a hostname or a branch.
  //
  // `deploy` = `next build && wrangler deploy`, so a staging release is
  //   NEXT_PUBLIC_TURNSTILE_SITE_KEY=<vibe widget> NEXT_PUBLIC_DEEPTYPE_PAY_TIER=test \
  //     bun run build && wrangler deploy --env stg
  // and it lands as the Worker `vibe-stg`.
  //
  // `main` / `assets` / `triggers` / `observability` / `compatibility_*` are inheritable and are NOT repeated.
  // `vars`, `define`, `hyperdrive` and `secrets_store_secrets` are non-inheritable: everything below has to be
  // restated in full, and anything omitted arrives as undefined rather than as the production value.
  "env": {
    "stg": {
      // No `routes` here, exactly as at the top level: the custom domain is Terraform's
      // (account-vibe/workers.tf), and declaring it in both places would give one binding two owners.
      //
      // ORDER: a Workers custom domain attaches to a Worker that already exists, so the FIRST
      // `wrangler deploy --env stg` has to run before that resource can apply — until then Cloudflare answers
      // 404 `This Worker does not exist on your account.` The Worker is simply unreachable in between.
      "workers_dev": false,
      // Same Supabase project and the SAME two Hyperdrive configs as production — the connection string is
      // identical and only the schema the SQL names is different.
      "define": { "DEEPTYPE_DB_SCHEMA": "'deeptype_stg'" },
      "hyperdrive": [
        { "binding": "HYPERDRIVE_FRESH", "id": "14e658152a554541b0e1a6712fc43787" },
        { "binding": "HYPERDRIVE_CACHED", "id": "a2a2c4cb90d94e6fb08b0eb6727bb61d" }
      ],
      "vars": {
        "DEEPTYPE_PORTONE_STORE_ID": "store-b5e2140b-9036-4122-b95a-caa90fc1e926",
        // 테스트. 테스트 채널은 심사가 없어 상점에 붙은 다섯이 모두 결제되므로, 스테이징은 카탈로그 전체를 파는
        // 유일한 배포이고 새 결제수단의 QA는 여기서만 할 수 있다.
        "DEEPTYPE_PAY_TIER": "test",
        "DEEPTYPE_PORTONE_CHANNELS": {
          "kakaopay": "channel-key-d80ebe96-61e3-49f9-b3eb-5dc22aee47b7",
          "kcp_v2": "channel-key-d48cde15-5f73-4ab2-9b40-2ec29d152ad5",
          // 포트원 제공 샌드박스 판매자 계정 중 "한국"에 붙인 테스트 채널. 목록의 국가는 구매자 국가가 아니라
          // 수취(판매자) 계정의 등록 국가이고, 실연동에서 연결할 본인 비즈니스 계정이 한국이라 테스트도 한국이다.
          "paypal_v2": "channel-key-8a0c783e-608f-48f0-a2f1-842667a464bc",
          "tosspay_v2": "channel-key-70320dc7-8e65-4cf7-901b-7b834ae4f21a",
          "tosspayments": "channel-key-e26cc617-35e1-4b69-86be-cb95f7c42f88"
        },
        "DEEPTYPE_PUBLIC_ORIGIN": "https://vibe-stg.sobok.cc",
        "DEEPTYPE_EMAIL_FROM": "sobok <sobok2026@gmail.com>",
        "DEEPTYPE_EMAIL_REPLY_TO": "sobok2026@gmail.com",
        "DEEPTYPE_REPORT_MODEL": "claude-haiku-4-5-20251001",
        "DEEPTYPE_LLM_ENABLED": "1",
        "DEEPTYPE_GA4_MEASUREMENT_ID": ""
      },
      "secrets_store_secrets": [
        {
          "binding": "DEEPTYPE_PORTONE_API_SECRET",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "deeptype-portone-api-secret"
        },
        // The one PortOne secret that IS per environment: the console issues webhook secrets separately for
        // 테스트 and 실연동, so a staging worker bound to the live secret rejects every test webhook.
        {
          "binding": "DEEPTYPE_PORTONE_WEBHOOK_SECRET",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "deeptype-portone-webhook-secret-stg"
        },
        {
          "binding": "DEEPTYPE_ANTHROPIC_API_KEY",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "deeptype-anthropic-api-key"
        },
        {
          "binding": "DEEPTYPE_RESEND_API_KEY",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "deeptype-resend-api-key"
        },
        {
          "binding": "DEEPTYPE_TURNSTILE_SECRET",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "vibe-turnstile-secret"
        },
        {
          "binding": "DEEPTYPE_DISCORD_WEBHOOK",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "deeptype-discord-webhook"
        },
        // Same credential as production, and it is never spent: DEEPTYPE_GA4_MEASUREMENT_ID above is "",
        // which is what stops confirmPurchase from sending. The kill switch is the destination, not the key.
        {
          "binding": "DEEPTYPE_GA4_API_SECRET",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "deeptype-ga4-api-secret"
        }
      ]
    }
  }
}

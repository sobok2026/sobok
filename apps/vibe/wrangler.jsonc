{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vibe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  // postgres.js 때문에 필요하다 — Supabase Postgres를 Workers TCP 소켓 API(Hyperdrive 경유)로 접속한다.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      // FRESH = 돈·엔티틀먼트 경로
      "binding": "HYPERDRIVE_FRESH",
      "id": "14e658152a554541b0e1a6712fc43787"
    },
    {
      // CACHED = 완료된 리포트 본문 읽기 전용
      "binding": "HYPERDRIVE_CACHED",
      "id": "a2a2c4cb90d94e6fb08b0eb6727bb61d"
    }
  ],
  "define": { "DEEPTYPE_DB_SCHEMA": "'deeptype'" },
  "services": [{ "binding": "PAYMENTS", "service": "payments", "entrypoint": "VibePayments" }],
  "queues": {
    "consumers": [
      {
        "queue": "vibe-payment-events",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60,
        "dead_letter_queue": "vibe-payment-events-dlq"
      }
    ]
  },
  "vars": {
    "DEEPTYPE_PAY_TIER": "live",
    "DEEPTYPE_PUBLIC_ORIGIN": "https://vibe.sobok.cc",
    "DEEPTYPE_EMAIL_FROM": "sobok <sobok2026@gmail.com>",
    "DEEPTYPE_EMAIL_REPLY_TO": "sobok2026@gmail.com",
    "DEEPTYPE_REPORT_MODEL": "", // "claude-haiku-4-5-20251001",
    "DEEPTYPE_GA4_MEASUREMENT_ID": "G-RHHX4JRYDS"
  },
  "secrets_store_secrets": [
    {
      "binding": "DEEPTYPE_ANTHROPIC_API_KEY",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "deeptype-anthropic-api-key"
    },
    {
      "binding": "DEEPTYPE_RESEND_API_KEY",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "deeptype-resend-api-key"
    },
    {
      "binding": "DEEPTYPE_TURNSTILE_SECRET",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "vibe-turnstile-secret"
    },
    {
      "binding": "DEEPTYPE_DISCORD_WEBHOOK",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "deeptype-discord-webhook"
    },
    {
      "binding": "DEEPTYPE_GA4_API_SECRET",
      "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
      "secret_name": "deeptype-ga4-api-secret"
    }
  ],
  // `vars`·`define`·`hyperdrive`·`secrets_store_secrets`는 상속되지 않는다: 이름 있는 환경은 전부 다시
  // 선언해야 하고 빠뜨린 키는 프로덕션 값이 아니라 undefined로 온다.
  // (`main`/`assets`/`observability`/`compatibility_*`는 상속돼서 반복하지 않는다.)
  "env": {
    "stg": {
      "workers_dev": false,
      "define": { "DEEPTYPE_DB_SCHEMA": "'deeptype_stg'" },
      "services": [{ "binding": "PAYMENTS", "service": "payments-stg", "entrypoint": "VibePayments" }],
      "queues": {
        "consumers": [
          {
            "queue": "vibe-payment-events-stg",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "retry_delay": 60,
            "dead_letter_queue": "vibe-payment-events-stg-dlq"
          }
        ]
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE_FRESH",
          "id": "14e658152a554541b0e1a6712fc43787"
        },
        {
          "binding": "HYPERDRIVE_CACHED",
          "id": "a2a2c4cb90d94e6fb08b0eb6727bb61d"
        }
      ],
      "vars": {
        "DEEPTYPE_PAY_TIER": "test",
        "DEEPTYPE_PUBLIC_ORIGIN": "https://vibe-stg.sobok.cc",
        "DEEPTYPE_EMAIL_FROM": "sobok <sobok2026@gmail.com>",
        "DEEPTYPE_EMAIL_REPLY_TO": "sobok2026@gmail.com",
        "DEEPTYPE_REPORT_MODEL": "",
        "DEEPTYPE_GA4_MEASUREMENT_ID": ""
      },
      "secrets_store_secrets": [
        {
          "binding": "DEEPTYPE_ANTHROPIC_API_KEY",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "deeptype-anthropic-api-key"
        },
        {
          "binding": "DEEPTYPE_RESEND_API_KEY",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "deeptype-resend-api-key"
        },
        {
          "binding": "DEEPTYPE_TURNSTILE_SECRET",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "vibe-turnstile-secret"
        },
        {
          "binding": "DEEPTYPE_DISCORD_WEBHOOK",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "deeptype-discord-webhook"
        },
        {
          "binding": "DEEPTYPE_GA4_API_SECRET",
          "store_id": "ec3ebef58eda49c08006fc6528dbfbfe",
          "secret_name": "deeptype-ga4-api-secret"
        }
      ]
    }
  }
}

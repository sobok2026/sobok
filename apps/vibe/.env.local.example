# Required, no fallback. Cloudflare's always-pass test sitekey is NOT usable: the Worker pins both hostname
# and action, and siteverify's canned dummy response carries neither. Use the dev Turnstile widget
# (`terraform output -raw dev_turnstile_sitekey` in sobok-ops).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<dev-turnstile-sitekey>

# Which PortOne 설정 모드 this build's paywall renders the menu for — `test` (테스트) or `live` (실연동). Required,
# no fallback: `test` on a production build would put unapproved methods on the paywall and `live` on staging
# would hide the methods staging exists to QA, so neither is a safe guess. Locally it is always `test` — the
# menu then matches `vibe-stg`, which is the only deployment that can open a 테스트 window.
NEXT_PUBLIC_DEEPTYPE_PAY_TIER=test

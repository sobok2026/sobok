{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@deep-type/*": ["./deep-type/*"]
    },
    "resolveJsonModule": true,
    "types": ["bun", "node", "react", "react-dom"]
  },
  "include": ["next-env.d.ts", "*.ts", "deep-type/**/*.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "out"]
}

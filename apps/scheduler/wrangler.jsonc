{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "scheduler",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Cloudflare cron expressions use UTC. These are the only Worker Cron Triggers managed by Sobok apps.
  "triggers": {
    "crons": ["*/15 * * * *", "0 3 * * *"]
  },
  "services": [
    {
      "binding": "VIBE_PRODUCTION",
      "service": "database",
      "entrypoint": "VibeMaintenance"
    },
    {
      "binding": "VIBE_STAGING",
      "service": "database-stg",
      "entrypoint": "VibeMaintenance"
    },
    {
      "binding": "STELLA_PRODUCTION",
      "service": "database",
      "entrypoint": "StellaMaintenance"
    },
    {
      "binding": "STELLA_STAGING",
      "service": "database-stg",
      "entrypoint": "StellaMaintenance"
    }
  ]
}

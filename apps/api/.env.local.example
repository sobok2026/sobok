APP_ORIGIN=http://localhost:3000
APP_POSTGRES_URL=postgres://test_user:test_password@localhost:5434/app_db
# Required, no defaults. BETTER_AUTH_SECRET must be at least 32 characters; the value below is a throwaway
# for local development only. TURNSTILE_SECRET_KEY must be the dev Turnstile widget's secret
# (`terraform output -raw dev_turnstile_secret_key` in sobok-ops) — Cloudflare's always-pass test secret
# cannot satisfy the strict verifier, which pins both hostname and action.
# Uncomment ONLY if you drive the API with a tool that sends no Origin header (curl, Postman). A browser at
# APP_ORIGIN already passes the CSRF origin check without this. Never set it in a deployed environment.
# ALLOW_ANY_REQUEST_ORIGIN=true
BETTER_AUTH_SECRET=local-dev-only-not-a-real-secret-0
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
PAYMENTS_SERVICE_URL=http://localhost:8787
PAYMENTS_SERVICE_TOKEN=local-payments-service-token-000000000
PAYMENTS_EVENT_TOKEN=local-payments-event-token-00000000000
REDIS_URL=redis://localhost:6380
TURNSTILE_SECRET_KEY=<dev-turnstile-secret>
VAPID_PRIVATE_KEY=<dev-vapid-private-key>
VAPID_PUBLIC_KEY=<dev-vapid-public-key>

{
  "name": "@sobok/chat-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:local",
    "dev:local": "bun run --env-file=.env.local --watch src/worker.ts",
    "dev:prod": "bun run --env-file=.env.prod.dev --watch src/worker.ts",
    "build": "bun build --compile --minify --sourcemap src/worker.ts --target=bun --outfile dist/sobok-chat-worker",
    "start": "bun run start:prod",
    "start:local": "bun --env-file=.env.local src/worker.ts",
    "start:prod": "bun --env-file=.env.prod.runtime src/worker.ts",
    "type": "tsc --noEmit",
    "docker:build": "docker build -f Dockerfile -t sobok-chat-worker-local ../..",
    "docker:run": "docker run --rm --env-file .env.prod.runtime sobok-chat-worker-local"
  },
  "dependencies": {
    "@sobok/db": "workspace:*",
    "@sobok/domain": "workspace:*",
    "@sobok/events": "workspace:*",
    "@sobok/kv": "workspace:*",
    "@sobok/std": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "typescript": "^6.0.3"
  }
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fall",
  "compatibility_date": "2026-09-01",
  // Assets-only Worker: the static Next.js export in ./out is served directly at the edge.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "env": {
    "stg": {
      "workers_dev": false
    }
  }
}

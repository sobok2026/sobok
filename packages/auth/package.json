{
  "name": "@sobok/auth",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./account-client": "./src/account-client.ts",
    "./authority": "./src/authority.ts",
    "./client": "./src/client.ts",
    "./contracts": "./src/contracts.ts",
    "./oauth-client-secret": "./src/oauth-client-secret.ts",
    "./relying-party": "./src/relying-party.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "type": "tsc --noEmit",
    "generate": "bunx @better-auth/cli@latest generate --config src/auth.ts --output ../db/src/app/schema/auth.ts --yes && bunx biome check --write ../db/src/app/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.6.23",
    "@better-auth/passkey": "^1.6.18",
    "@better-auth/redis-storage": "^1.6.18",
    "@sobok/payments": "workspace:*",
    "@sobok/contracts": "workspace:*",
    "@sobok/db": "workspace:*",
    "@sobok/domain": "workspace:*",
    "@sobok/env": "workspace:*",
    "@sobok/kv": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.2.17"
  }
}
